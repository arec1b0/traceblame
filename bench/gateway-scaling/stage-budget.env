# p95 budgets of the pipeline lag per stage (#57), seconds. Starting hypotheses (CLAUDE.md
# rule 8), derived from ADR-0003 "Lag SLO impact": the SLO is p95 <= 60 s from span end to
# blame written (design §1.5, alert PipelineLagHigh); ADR-0003 has the assembler see a trace
# about 35-40 s after its first span ended (decision_wait 30 s, exporter batch, grace 5 s, poll
# 2 s) and leaves about 20 s for the detectors and the attributor.
# Read by bench/gateway-scaling/stage_report.py, which refuses a sum above SLO_P95_S.
#
# Sum: 1 + 1 + 31 + 0.1 + 1 + 6 + 19.9 = 60.0 s.

# root end -> agent stamp: the generator's send delay (spans are exported as they end).
BUDGET_GENERATOR_TO_AGENT_S=1
# agent -> gateway: agent normalizer, loadbalancing file queue, network/mTLS.
BUDGET_AGENT_TO_GATEWAY_S=1
# gateway receive -> after tail_sampling: decision_wait 30 s plus the 1 s decision tick.
BUDGET_GATEWAY_TO_DECIDED_S=31
# after tail_sampling -> enqueue to the ClickHouse exporter (processors in between).
BUDGET_DECIDED_TO_ENQUEUE_S=0.1
# enqueue -> ingested_at: the exporter's sending queue, INSERT, async-insert buffer, MV.
BUDGET_ENQUEUE_TO_CLICKHOUSE_S=1
# The trace-assembler: grace 5 s plus the poll interval (measured 6-7 s p95 in #56).
BUDGET_ASSEMBLER_S=6
# Detectors and attributor after trace.completed; not measured by this bench.
BUDGET_DETECTORS_ATTRIBUTOR_S=19.9

SLO_P95_S=60

# The stamps overlay must not change what it measures: the low profile with and without it
# may differ by at most these (end-to-end p50, and p95 as max(absolute, relative x p95)).
DISTORTION_P50_S=0.5
DISTORTION_P95_S=1
DISTORTION_P95_REL=0.05
