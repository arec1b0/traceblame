# Pinned tool versions: the single source of truth for Makefile, scripts and CI.
# sha256 checksums for the linux-amd64 artifacts live in tools/checksums.txt.
# Python tools (ruff, pyright, pre-commit, pytest) are pinned in pyproject.toml + uv.lock;
# the Python version is pinned in .python-version.
UV_VERSION=0.13.6
GO_VERSION=1.27.3
GOLANGCI_LINT_VERSION=2.15.0
HADOLINT_VERSION=2.15.1
GITLEAKS_VERSION=8.30.1
ACTIONLINT_VERSION=1.7.12
KIND_VERSION=0.33.0
KUBECTL_VERSION=1.37.2
KUBECONFORM_VERSION=0.8.0
# TypeScript shim (sdk/ts, #13): Node 22 LTS ("Jod") and pnpm, the standalone linux-x64 binary.
NODE_VERSION=22.23.4
PNPM_VERSION=10.34.9
# Default node image of kind v0.33.0, from its release notes.
KIND_NODE_IMAGE=kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5
# Scanners for `make security` (scripts/security.sh), pinned by multi-arch index digest.
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
SYFT_IMAGE=anchore/syft:v1.55.0@sha256:4cc92b64ca74ffca4c94d4c8fcc01f217731375300be14d0b6eeb2e82eaa110a
GRYPE_IMAGE=anchore/grype:v0.121.0@sha256:621d56d1d68106b787022c81546f7e0a36202a25d1239f0c20195fab8c16f7ea
# Used only by tools/fixtures/capture.py (installed on demand: scripts/install-tools.sh otelcol-contrib).
OTELCOL_CONTRIB_VERSION=0.164.0
# Collector distribution (collector/builder-config.yaml): one upstream release line, the module
# set of otelcol-contrib 0.164.0. ocb and the core beta modules share OCB_VERSION; contrib
# ships the v0.164.1 patch (contrib#52356), whose stable-base module set (pkg/ottl, needed
# by tailsamplingprocessor) is v1.3.1. collector/builder_config_test.go checks these.
OCB_VERSION=0.164.0
OTELCOL_CORE_STABLE_VERSION=1.70.0
OTELCOL_CONTRIB_MODULES_VERSION=0.164.1
OTELCOL_CONTRIB_STABLE_VERSION=1.3.1
# Collector image (collector/Dockerfile), pinned by multi-arch index digest. The build image
# carries GO_VERSION.
GO_BUILD_IMAGE=golang:1.27.3-trixie@sha256:c65ecfe613b539ac74c62a4c3b2c27e8f8a6076384c8f27e8a3c0f3be17cc385
DISTROLESS_STATIC_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:18f4cc26c9ffa7f20a359298be7deadac5c607c8e03a02b8119f1a5fc2f82c99
# ClickHouse server for integration tests and the kind cluster: the 26.8 LTS line, release
# v26.8.34.13-lts, pinned by multi-arch index digest.
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.34.13@sha256:8b28eb09479c36c4533eec7a6268917d04ba3a6fd90e3f4205f70e761b6d7779
# kind cluster (deploy/kind): Altinity ClickHouse operator bundle (sha256 in tools/checksums.txt),
# its images pinned by digest at deploy time, and busybox for the agent's queue-directory init.
CLICKHOUSE_OPERATOR_VERSION=0.27.4
CLICKHOUSE_OPERATOR_IMAGE=altinity/clickhouse-operator:0.27.4@sha256:c60c872fedd85017f843167dfdd2b900bb06b668a3deaf02b21782e59af859e3
CLICKHOUSE_OPERATOR_METRICS_IMAGE=altinity/metrics-exporter:0.27.4@sha256:d257a72e6a6a9e1a9768b7a5a231b56901ea6dee668e41c7243b78bd298f631a
BUSYBOX_IMAGE=busybox:1.37.0@sha256:a7dbc319b1438115a207e11930dc4bb3e643dcb3ec0bdd694bb36cd8fad289ec
# Runbook-agent sandbox (#13, deploy/kind/runbook): monitoring that fires real alerts, the tee
# collector of the capture, and the Python image of the sandbox workloads.
PROMETHEUS_IMAGE=prom/prometheus:v3.15.1@sha256:fa3302279710be2f21a8301ec17a8b4f2301fd829bd113839b3b6b02b6f191a2
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.2@sha256:39d8bb3966c694a124428a3a88fbcffd40bd069129ecd47c059f8a3f17c55f3b
BLACKBOX_EXPORTER_IMAGE=prom/blackbox-exporter:v0.29.1@sha256:ea1c7aa3ef3f307cd03e85f34abb604478ccb90b567fc690da0cd9776da76b13
KUBE_STATE_METRICS_IMAGE=registry.k8s.io/kube-state-metrics/kube-state-metrics:v2.20.0@sha256:42cfe3723a5f058171c627537fb57a3ea0f26e4380fa18555a95cb1a1b4cfc5b
OTELCOL_CONTRIB_IMAGE=otel/opentelemetry-collector-contrib:0.164.0@sha256:340c9ca6a36617084c6661bdc4f0fe92b7cda5a805d61673ec8db375fddc522b
PYTHON_IMAGE=python:3.12.13-alpine3.22@sha256:a190708a2dec1bd18b1decb539f8e8f5407abaa9bf39cacda583f7f8c11db322
# Alert rules of the sandbox: expressions verbatim from this commit (sha256 in tools/checksums.txt).
AWESOME_PROMETHEUS_ALERTS_COMMIT=736370e922cee74db497391c825a7a6bd3d48f17
