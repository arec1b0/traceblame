{
  "_comment": "What traceblame-ts may export (ADR-0006 sections 3 and 6). tests/contract/test_shim_contract.py checks every key against the profile and the mapping tables.",
  "scopes": {
    "aegis.tenant.id": "resource",
    "aegis.eval.run.id": "resource",
    "aegis.session.id": "span",
    "aegis.bundle.digest": "span",
    "aegis.decision.id": "span",
    "aegis.fault.injection.id": "span",
    "aegis.tool.args_hash": "span",
    "aegis.output.parse_ok": "span"
  },
  "patterns": {
    "aegis.eval.run.id": "^[A-Za-z0-9._:-]{1,128}$",
    "aegis.fault.injection.id": "^[A-Za-z0-9._:-]{1,128}$",
    "aegis.bundle.digest": "^sha256:[0-9a-f]{64}$",
    "aegis.tool.args_hash": "^[0-9a-f]{16}$"
  },
  "span_keys": [
    "gen_ai.operation.name",
    "gen_ai.provider.name",
    "gen_ai.request.model",
    "gen_ai.response.model",
    "gen_ai.request.max_tokens",
    "gen_ai.response.finish_reasons",
    "gen_ai.usage.input_tokens",
    "gen_ai.usage.output_tokens",
    "gen_ai.conversation.id",
    "server.address",
    "error.type",
    "http.response.status_code",
    "gen_ai.tool.name",
    "gen_ai.tool.call.id",
    "gen_ai.agent.name",
    "gen_ai.agent.id",
    "aegis.tool.args_hash",
    "aegis.output.parse_ok",
    "aegis.session.id",
    "aegis.bundle.digest",
    "aegis.decision.id",
    "aegis.fault.injection.id",
    "openinference.span.kind",
    "tool.name",
    "agent.name",
    "ai.operationId",
    "operation.name",
    "ai.sdk.version",
    "ai.response.timestamp",
    "ai.settings.maxRetries",
    "ai.settings.mode",
    "ai.settings.output",
    "gen_ai.system",
    "gen_ai.usage.prompt_tokens",
    "gen_ai.usage.completion_tokens",
    "gen_ai.usage.total_tokens",
    "gen_ai.usage.cache_read.input_tokens",
    "gen_ai.response.id",
    "gen_ai.request.temperature"
  ],
  "resource_keys": [
    "service.name",
    "service.version",
    "service.instance.id",
    "aegis.tenant.id",
    "aegis.eval.run.id",
    "telemetry.sdk.language",
    "telemetry.sdk.name",
    "telemetry.sdk.version"
  ],
  "exception_keys": ["exception.type"]
}
