  "description": "Generated from the aegis-telemetry/1 profile, revision 1.0.0, on OTel semantic conventions 1.41.1. Do not edit: run `traceblame-contracts gen-schema`.",
  "properties": {
    "attributes": {
      "properties": {
        "aegis.bundle.digest": {
          "description": "Digest of the promptops bundle the span ran under.",
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "aegis.content.ref": {
          "description": "Reference to the encrypted out-of-band copy of prompt/completion content (TTL 7 d). Present only when the tenant opted in to content capture.",
          "pattern": "^s3://.+",
          "type": "string"
        },
        "aegis.decision.id": {
          "description": "AgentGate decision id.",
          "type": "string"
        },
        "aegis.profile.version": {
          "const": "aegis-telemetry/1",
          "description": "Profile id of this normalized span. Set by the normalizer.",
          "type": "string"
        },
        "aegis.retrieval.doc_ids": {
          "description": "Ids of the retrieved documents, in rank order.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "aegis.retrieval.scores": {
          "description": "Retrieval scores, aligned with aegis.retrieval.doc_ids.",
          "items": {
            "type": "number"
          },
          "type": "array"
        },
        "aegis.session.id": {
          "description": "User or application session the span belongs to.",
          "type": "string"
        },
        "aegis.span.kind": {
          "description": "Span class the detectors key on. Set by the normalizer, so that upstream renames of operation names touch only mapping tables.",
          "enum": [
            "llm",
            "embedding",
            "retrieval",
            "tool",
            "agent",
            "chain"
          ],
          "type": "string"
        },
        "aegis.tool.args_hash": {
          "description": "Hash of the tool call arguments. The shim computes it in-process, so the arguments themselves are never exported.",
          "pattern": "^[0-9a-f]{16}$",
          "type": "string"
        },
        "error.type": {
          "description": "Class of error the operation ended with.",
          "type": "string"
        },
        "gen_ai.agent.id": {
          "description": "Unique agent id.",
          "type": "string"
        },
        "gen_ai.agent.name": {
          "description": "Human-readable agent name.",
          "type": "string"
        },
        "gen_ai.completion": {
          "description": "Forbidden: deprecated raw completion content",
          "not": {}
        },
        "gen_ai.conversation.id": {
          "description": "Conversation or thread id, when the application has one.",
          "type": "string"
        },
        "gen_ai.data_source.id": {
          "description": "Data source used for retrieval or grounding.",
          "type": "string"
        },
        "gen_ai.input.messages": {
          "description": "Forbidden: raw prompt content",
          "not": {}
        },
        "gen_ai.operation.name": {
          "description": "Name of the GenAI operation.",
          "type": "string"
        },
        "gen_ai.output.messages": {
          "description": "Forbidden: raw completion content",
          "not": {}
        },
        "gen_ai.prompt": {
          "description": "Forbidden: deprecated raw prompt content",
          "not": {}
        },
        "gen_ai.provider.name": {
          "description": "GenAI provider as identified by the instrumentation.",
          "type": "string"
        },
        "gen_ai.request.max_tokens": {
          "description": "Maximum number of tokens the model may generate.",
          "type": "integer"
        },
        "gen_ai.request.model": {
          "description": "Model name in the request.",
          "type": "string"
        },
        "gen_ai.response.finish_reasons": {
          "description": "Reasons the model stopped generating, one per choice.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "gen_ai.response.model": {
          "description": "Model name in the response.",
