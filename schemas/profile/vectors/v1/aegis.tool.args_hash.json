{
  "attribute": "aegis.tool.args_hash",
  "algorithm_version": 1,
  "vectors": [
    {
      "id": "rfc8785-3-2-3-sample",
      "input": "{\n       \"numbers\": [333333333.33333329, 1E30, 4.50,\n                   2e-3, 0.000000000000000000000000001],\n       \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\/\",\n       \"literals\": [null, true, false]\n     }",
      "canonical": "{\"literals\":[null,true,false],\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\"\u20ac$\\u000f\\nA'B\\\"\\\\\\\\\\\"/\"}",
      "expected": "2d5e01a318d0f087",
      "note": "RFC 8785 section 3.2.2 sample object and its canonical form (3.2.3)."
    },
    {
      "id": "rfc8785-3-2-3-utf16-property-order",
      "input": "{\n       \"\\u20ac\": \"Euro Sign\",\n       \"\\r\": \"Carriage Return\",\n       \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n       \"1\": \"One\",\n       \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n       \"\\u0080\": \"Control\",\n       \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n     }",
      "canonical": "{\"\\r\":\"Carriage Return\",\"1\":\"One\",\"\u0080\":\"Control\",\"\u00f6\":\"Latin Small Letter O With Diaeresis\",\"\u20ac\":\"Euro Sign\",\"\ud83d\ude00\":\"Emoji: Grinning Face\",\"\ufb33\":\"Hebrew Letter Dalet With Dagesh\"}",
      "expected": "5e321556d22018a9",
      "note": "RFC 8785 section 3.2.3: properties sort by UTF-16 code units, so U+1F600 (D83D DE00) precedes U+FB33."
    },
    {
      "id": "key-order-flat",
      "input": "{\"units\": \"metric\", \"city\": \"Paris\"}",
      "canonical": "{\"city\":\"Paris\",\"units\":\"metric\"}",
      "expected": "016ad0ce38cd3c9a",
      "note": "The tool call from the normalizer's own test: keys sort, whitespace goes."
    },
    {
      "id": "key-order-already-canonical",
      "input": "{\"a\":1,\"b\":2}",
      "canonical": "{\"a\":1,\"b\":2}",
      "expected": "43258cff783fe703",
      "note": "Canonical input is unchanged."
    },
    {
      "id": "key-order-nested",
      "input": "{\"b\": [3, {\"z\": 1, \"a\": 2}], \"a\": {\"d\": [], \"c\": {}}}",
      "canonical": "{\"a\":{\"c\":{},\"d\":[]},\"b\":[3,{\"a\":2,\"z\":1}]}",
      "expected": "88b956832dd276b1",
      "note": "Objects sort at every depth; arrays keep their order."
    },
    {
      "id": "key-order-array-order-kept",
      "input": "[3, 1, 2, [\"b\", \"a\"]]",
      "canonical": "[3,1,2,[\"b\",\"a\"]]",
      "expected": "02e209760efb252d",
      "note": "Array elements are never sorted."
    },
    {
      "id": "key-order-whitespace-around",
      "input": "  \n{\"b\" : 1 ,\t\"a\":2}\r\n ",
      "canonical": "{\"a\":2,\"b\":1}",
      "expected": "d3626ac30a87e6f7",
      "note": "Insignificant whitespace, including leading and trailing, does not reach the hash."
    },
    {
      "id": "number-appendix-b",
      "input": "[0, -0, 5e-324, -5e-324, 1.7976931348623157e308, 9007199254740992, 1e23, 0.000001, 1e-7, 333333333.33333329, 1E30, 4.50, 2e-3, 1e21, 1e-27]",
      "canonical": "[0,0,5e-324,-5e-324,1.7976931348623157e+308,9007199254740992,1e+23,0.000001,1e-7,333333333.3333333,1e+30,4.5,0.002,1e+21,1e-27]",
      "expected": "7dcefd97e2e8482f",
      "note": "RFC 8785 appendix B samples written as JSON numbers: -0, denormals, the 1e+21 and 1e-7 switches, 1e+23."
    },
    {
      "id": "number-integers-and-fractions",
      "input": "[1, 10, 100.0, 1.0, 12345678901234567890, 0.1, 0.30000000000000004, -1.5E+2, 0e0, 1.0e0, 123456789012345680000]",
