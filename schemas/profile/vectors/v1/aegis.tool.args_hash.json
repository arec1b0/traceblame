      "input": "{\"name\": \"caf\u00e9\", \"city\": \"Z\u00fcrich\"}",
      "canonical": "{\"city\":\"Z\u00fcrich\",\"name\":\"caf\u00e9\"}",
      "expected": "59f37625e80323c8",
      "note": "The literal spelling of unicode-escape-equals-literal-a: the same hash."
    },
    {
