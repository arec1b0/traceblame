      "expected": "a98ce65fe6c0c7da",
      "note": "Integers and fractions as IEEE 754 doubles: 100.0 is 100, 12345678901234567890 loses precision, exponent forms fold."
    },
    {
      "id": "string-escapes",
      "input": "[\"\\u0000\\u0001\\b\\t\\n\\f\\r\\u001f\\u007f\\\"\\\\\\/\"]",
      "canonical": "[\"\\u0000\\u0001\\b\\t\\n\\f\\r\\u001f\u007f\\\"\\\\/\"]",
      "expected": "3a0ff22fc382b5b4",
      "note": "Only controls below U+0020, the quote and the backslash are escaped; DEL and '/' are literal."
    },
    {
